{
  "info": {
    "name": "Project 10 - Aero-MRO-Sync Automated Test Suite",
    "description": "Automated regression and security test suite validating all 7 mandatory test scenarios (TC-01 through TC-07) for Project 10 Aviation MRO Assessment.",
