  "item": [
    {
      "name": "TC-01: Happy Path Critical Engine AOG (Valid HMAC, DTW Spare, Part 145)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          },
          {
            "key": "x-mro-signature-sha256",
            "value": "6050887d280a36d638752d84ba48367eeace2ee215e799307b3a3105264d1ced"
          },
          {
            "key": "x-mro-timestamp",
            "value": "{{current_timestamp}}"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"faultId\": \"ACARS-2026-55102\",\n  \"aircraftTailNumber\": \"N842UA\",\n  \"ataChapterCode\": \"72-30\",\n  \"partNumber\": \"CFM-HPT-BLADE-9\",\n  \"partSerialNumber\": \"SN-ENG-44091\",\n  \"gateAssignmentId\": \"GATE-ORD-B14\",\n  \"inspectorPhone\": \"+1 (773) 555-0162\",\n  \"inspectorEmail\": \"chief.inspector@aero-mro.aero\",\n  \"faultDetectedUtc\": \"2026-11-18T13:20:00Z\"\n}"
        },
        "url": {
          "raw": "{{webhook_url}}/v1/mro/acars-fault",
          "host": [
            "{{webhook_url}}"
          ],
          "path": [
            "v1",
            "mro",
            "acars-fault"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('TC-01: Status code is 202 Accepted', function () {",
              "    pm.expect([200, 202]).to.include(pm.response.code);",
              "});",
              "pm.test('TC-01: Response returns valid acceptance receipt', function () {",
              "    var json = pm.response.json();",
              "    pm.expect(json).to.be.an('object');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
