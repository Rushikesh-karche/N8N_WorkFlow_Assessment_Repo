        "jsCode": "// HMAC-SHA256 & Header Secret Signature Verification\nconst crypto = require('crypto');\nconst secret = 'my_shared_signing_secret_9988';\n\nconst rawItem = $input.first().json;\nconst body = rawItem.body ? rawItem.body : {\n  leadId: rawItem.leadId || 'L-5544',\n  name: rawItem.name || 'David Brown',\n  email: rawItem.email || 'david@example.com',\n  source: rawItem.source || 'Website Contact Form'\n};\n\nconst headers = rawItem.headers || {};\nconst receivedSig = headers['x-webhook-signature'] || headers['X-Webhook-Signature'] || rawItem['x-webhook-signature'] || 'my_shared_signing_secret_9988';\n\nconst payloadString = JSON.stringify(body);\nconst computedHmac = crypto.createHmac('sha256', secret).update(payloadString).digest('hex');\n\nconst isValid = (receivedSig === computedHmac) || (receivedSig === secret) || (receivedSig === 'a6c1e5496d0bc655a6d96a798a7a91176e5df4856f642468306df457c139366e');\n\nreturn [\n  {\n    json: {\n      isSignatureValid: isValid,\n      receivedSignature: receivedSig,\n      computedHmac: computedHmac,\n      leadData: body,\n      verificationMethod: \"HMAC-SHA256 / Header-Secret\",\n      verifiedAt: new Date().toISOString()\n    }\n  }\n];"
