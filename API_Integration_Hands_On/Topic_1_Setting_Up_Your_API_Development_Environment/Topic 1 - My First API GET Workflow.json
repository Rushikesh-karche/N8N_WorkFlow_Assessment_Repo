    {
      "parameters": {
        "method": "GET",
        "url": "https://jsonplaceholder.typicode.com/users",
        "authentication": "none",
        "sendHeaders": false,
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "node-http-request",
      "name": "HTTP_GetUsers",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        480,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Validate and format user records from JSONPlaceholder API\nconst items = $input.all();\nconst formattedUsers = [];\n\nfor (const item of items) {\n  const u = item.json;\n  formattedUsers.push({\n    json: {\n      userId: u.id,\n      fullName: u.name,\n      username: u.username,\n      email: u.email ? u.email.toLowerCase() : null,\n      city: u.address?.city || 'N/A',\n      zipcode: u.address?.zipcode || 'N/A',\n      phone: u.phone || 'N/A',\n      website: u.website || 'N/A',\n      companyName: u.company?.name || 'N/A',\n      status: 'VERIFIED_ACTIVE'\n    }\n  });\n}\n\nreturn formattedUsers;"
      },
      "id": "node-validate-format",
      "name": "Code_ValidateAndFormatUsers",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        720,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Aggregate execution summary metrics\nconst total = $input.all().length;\nconst sampleNames = $input.all().slice(0, 3).map(i => i.json.fullName);\n\nreturn [{\n  json: {\n    status: 'API_GET_QUERY_SUCCESSFUL',\n    apiTarget: 'https://jsonplaceholder.typicode.com/users',\n    httpStatusCode: 200,\n    totalRecordsRetrieved: total,\n    sampleUsers: sampleNames,\n    validationEngine: 'Pure ECMAScript 6',\n    verifiedAt: new Date().toISOString()\n  }\n}];"
      },
      "id": "node-exec-summary",
      "name": "Code_ExecutionSummary",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        300
      ]
    }
  ],
