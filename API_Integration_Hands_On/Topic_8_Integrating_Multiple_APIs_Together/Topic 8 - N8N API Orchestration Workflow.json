      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        100,
        300
      ]
    },
    {
      "parameters": {
        "fields": {
          "values": [
            {
              "name": "ticketId",
              "type": "stringValue",
              "stringValue": "TCK-8855"
            },
            {
              "name": "customerEmail",
