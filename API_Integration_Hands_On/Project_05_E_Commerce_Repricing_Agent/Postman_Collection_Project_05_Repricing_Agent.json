    {
      "name": "TC-003: Missing Mandatory Catalog Attributes (HTTP 400 Bad Request)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 400 Bad Request', function () {",
              "    pm.response.to.have.status(400);",
              "});",
              "pm.test('Returns INVALID_CATALOG_ITEM error code', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.error).to.eql('INVALID_CATALOG_ITEM');",
              "    pm.expect(jsonData.missing_fields).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
