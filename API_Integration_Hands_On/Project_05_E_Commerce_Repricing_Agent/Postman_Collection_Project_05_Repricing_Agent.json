  "item": [
    {
      "name": "TC-001: Competitor Undercut Above Floor (Normal Adjustment)",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "pm.test('Repricing completed and price adjusted', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.status).to.eql('COMPLETED');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"catalog\": [\n    {\n      \"sku\": \"TECH-CAM-4K-01\",\n      \"title\": \"UltraHD 4K Streaming Webcam with Ring Light\",\n      \"variant_id\": \"449102910291\",\n      \"cogs\": 42.5,\n      \"current_price\": 79.99,\n      \"map_price\": 64.99,\n      \"inventory_quantity\": 420,\n      \"target_margin_percent\": 30\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{base_url}}/webhook/sku-repricing-trigger",
          "host": [
            "{{base_url}}"
          ],
          "path": [
            "webhook",
            "sku-repricing-trigger"
          ]
        }
      }
    },
